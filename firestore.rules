rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net (Pillar 1)
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive definitions and helper validation functions (Phase 3)
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validator for User payload schema rules
    function isValidUser(data) {
      return data.id is string && 
        data.email is string && data.email.size() <= 120 &&
        data.name is string && data.name.size() <= 100 &&
        data.role is string && (data.role == 'user' || data.role == 'recruiter' || data.role == 'admin') &&
        data.plan is string && (data.plan == 'free' || data.plan == 'student_pro' || data.plan == 'premium' || data.plan == 'lifetime') &&
        data.portfolioCount is int &&
        data.aiUsageCount is int;
    }

    // Validator for Portfolio payload schema rules
    function isValidPortfolio(data) {
      return data.id is string &&
        data.userId is string &&
        data.title is string && data.title.size() <= 200 &&
        data.templateId is string && (
          data.templateId == 'cyberpunk' || 
          data.templateId == 'glassmorphism' || 
          data.templateId == 'professional' || 
          data.templateId == 'creative' || 
          data.templateId == 'founder' || 
          data.templateId == 'neo_brutalist' || 
          data.templateId == 'midnight_nebula'
        ) &&
        data.accentColor is string && data.accentColor.size() <= 50 &&
        data.isPublished is bool &&
        data.slug is string && data.slug.size() <= 100;
    }

    // 1. User collection match block
    match /users/{userId} {
      allow get, list: if true;
      allow create, update: if isValidId(userId) && isValidUser(incoming());
      allow delete: if true;
    }

    // 2. Portfolio collection match block
    match /portfolios/{portfolioId} {
      allow get, list: if true;
      allow create, update: if isValidId(portfolioId) && isValidPortfolio(incoming());
      allow delete: if true;
    }
  }
}
